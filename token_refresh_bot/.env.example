# ==============================================================================
# TELEGRAM ACCOUNT TOKEN REFRESH BOT - RAILWAY & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# In Railway: Deploy in the same project. You only need to add the new
# REFRESH_BOT_* variables below; existing project variables will be reused automatically.

# ------------------------------------------------------------------------------
# 1. NEW DEDICATED VARIABLES FOR THIS REFRESH BOT (Add to Railway Variables)
# ------------------------------------------------------------------------------
# Dedicated Telegram Bot Token from @BotFather for this Refresh Bot
REFRESH_BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz_example

# Authorized Telegram user IDs (comma-separated, get from @userinfobot)
REFRESH_BOT_ALLOWED_USERS=123456789,987654321
REFRESH_BOT_ADMIN_USERS=123456789

# Optional: Dedicated Queue Controls
REFRESH_BOT_CONCURRENCY=3
REFRESH_BOT_RATE_LIMIT=0.5
REFRESH_BOT_MAX_RETRIES=3

# Optional: Dedicated Refresh URL (Leave empty to auto-use MEESHO_PROXY_BASE_URL)
REFRESH_BOT_PROVIDER_URL=

# ------------------------------------------------------------------------------
# 2. EXISTED PROJECT VARIABLES (Automatically Reused from Railway Project)
# ------------------------------------------------------------------------------
# The bot automatically inherits these existing variables if present:
# TELEGRAM_API_ID=...           <- Used to generate MTProto WebView X-Tg-Init-Data
# TELEGRAM_API_HASH=...         <- Used to authenticate with Telegram API
# TELEGRAM_STRING_SESSION=...   <- Authorized user session for WebApp access
# TELEGRAM_BOT_USERNAME=...     <- Default: primes_meesho_bot
# MEESHO_PROXY_BASE_URL=...     <- Default: https://meeshoshop.94.136.188.137.nip.io
# SESSION_SECRET=...            <- Reused as fallback encryption key if needed

# ------------------------------------------------------------------------------
# 3. STORAGE & RETENTION (Local / Container)
# ------------------------------------------------------------------------------
DATABASE_PATH=data/bot_storage.db
EXPORTS_DIR=exports
SCRATCH_DIR=scratch
TEMP_FILE_RETENTION_HOURS=24
