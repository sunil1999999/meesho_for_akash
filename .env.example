# ==============================================================================
# MEESHO MANAGEMENT DASHBOARD & TELEGRAM BOT AUTOMATION (.env.example)
# ==============================================================================

# Supabase Database Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt_key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_jwt_key

# Telegram API Credentials (https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_STRING_SESSION=your_string_session_here
TELEGRAM_BOT_USERNAME=primes_meesho_bot
TELEGRAM_PHONE=

# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Direct Checkout & Free Payment Mode
FREE_PAYMENT_MODE=true
VITE_FREE_PAYMENT_MODE=true

# Single-User Authentication & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH="$2b$12$7M7lb1baK8RT7rNLilbirudRb0sqEYT3W93RH3j9nrc/xfvaBazVC"
SESSION_SECRET="your_64_character_random_hex_secret_here"

# Token Refresh Bot (Optional)
REFRESH_BOT_TOKEN=""
ADMIN_USER_IDS=""
REFRESH_BOT_ADMIN_USERS=""
PUBLIC_BOT="true"

